{
  "name": "martin-mesh",
  "version": "1.0.0",
  "description": "Zero Internet 300m Dual-Engine Offline Mesh Messenger",
  "main": "main.js",
  "author": "Shauryansh",
  "private": true,
  "scripts": {
    "build": "mkdir -p www && cp index.html www/",
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.martinmesh.app",
    "productName": "MartinMesh",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "index.html",
      "main.js",
      "node_modules/**/*"
    ]
  }
}
